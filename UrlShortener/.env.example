# Database Secrets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_secret_password
POSTGRES_DB=linkforge_db

# Redis Secrets
REDIS_PASSWORD=your_super_secret_redis_password

# API Connections
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=linkforge_db;Username=postgres;Password=your_super_secret_password
ConnectionStrings__Redis=localhost:6379,password=your_super_secret_redis_password

# JWT Secrets
Jwt__Secret=your_very_long_and_super_secret_jwt_key_that_is_at_least_32_chars
Jwt__Issuer=LinkForge
Jwt__Audience=LinkForgeClients
