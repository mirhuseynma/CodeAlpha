# PostgreSQL
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=linkforge_db

# .NET API — Connection Strings (used in appsettings.Development.json or user-secrets)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=linkforge_db;Username=your_pg_user;Password=your_strong_password_here
# ConnectionStrings__Redis=localhost:6379

# JWT Secret (must be >= 32 chars, use a secure random string)
# JwtSettings__Secret=your_super_secret_jwt_key_at_least_32_chars

# Admin Seed Account
# AdminSettings__Email=admin@linkforge.io
