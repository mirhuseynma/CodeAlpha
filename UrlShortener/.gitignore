# .gitignore for LinkForge — C# .NET + React/Vite Monorepo

# ============================================================
# .NET / C#
# ============================================================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
_BuildLogs/

# Visual Studio cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# ============================================================
# Sensitive / Secret files — NEVER commit these
# ============================================================
.env
.env.local
.env.*.local
!.env.example
*.pfx
*.p12
secrets.json
appsettings.Development.json

# ============================================================
# Node / Frontend
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# ============================================================
# Docker
# ============================================================
# Keep docker-compose but never commit .env used by it
docker-compose.override.yml

# ============================================================
# Database
# ============================================================
*.sqlite
*.db
*.db-shm
*.db-wal

# ============================================================
# Misc
# ============================================================
*.bak
*.tmp
*.swp
.DS_Store
